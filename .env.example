# ===========================================================================
# MarvisXY 环境变量示例
# 复制为 .env 后按需填写。敏感信息（密钥/Token）一律只放 .env，不要提交到仓库。
# ===========================================================================

# ---- LLM 配置（OpenAI 兼容接口，支持 Ollama 等本地 API 服务）------------
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_API_KEY=sk-local-demo
OPENAI_MODEL=qwen3:latest
LLM_TEMPERATURE=0.2

# ---- 日志 ----------------------------------------------------------------
LOG_LEVEL=INFO

# ---- 子 Agent 行为开关 ----------------------------------------------------
FILE_AGENT_ENABLED=true
APP_AGENT_ENABLED=true
BROWSER_AGENT_ENABLED=true
COMPUTER_AGENT_ENABLED=true

# ---- 浏览器 Agent 可选参数（预留）-----------------------------------------
BROWSER_HEADLESS=false
BROWSER_TIMEOUT_SECONDS=30

# ---- OpenViking 持久化记忆 -----------------------------------------------
OPENVIKING_URL=http://127.0.0.1:1933
# 本地 trusted 模式使用独立随机 root key；托管服务填写用户 API key。
OPENVIKING_API_KEY=
# 理解模型用于摘要和记忆提取；可填独立的 OpenAI 兼容端点。
OPENVIKING_VLM_BASE_URL=
OPENVIKING_VLM_MODEL=
OPENVIKING_VLM_API_KEY=
# 默认 Embedding 使用 OpenViking 自带的本地 bge-small-zh-v1.5-f16。
